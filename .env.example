# Copie ce fichier en `.env` puis remplis les valeurs. Le fichier `.env` n'est jamais versionné.
# Aucune de ces variables n'est nécessaire pour `npm run demo` ni pour `npm test`.

# --- Services externes (optionnels : sans eux, le bot tourne mais enrichit/notifie moins) ---

# Clé API Helius (https://helius.dev, plan gratuit suffisant). Sert à mesurer la
# concentration des holders et l'état des autorités du token.
HELIUS_API_KEY=

# Bot Telegram pour les alertes (créé via @BotFather). Sans ces deux valeurs,
# les alertes sont simplement affichées dans la console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clé PumpPortal (optionnelle, nécessaire pour suivre les trades de plusieurs tokens).
PUMP_API_KEY=

# --- Réglages (valeurs par défaut = celles utilisées pour le jeu de données fourni) ---

OBSERVATION_WINDOW_MS=45000
MIN_SCORE_TO_ALERT=70
MAX_CONCURRENT_TRACKED=8
POST_ALERT_TRACKING_MS=900000
SCORING_TRACKING_MS=300000
MIN_TRACKING_HEADROOM=1

# Simulation de trading (papier). Aucune transaction réelle n'est jamais envoyée.
TRADE_AMOUNT_SOL=0.1
MAX_CONCURRENT_POSITIONS=3
